# === LLM ===
# Provider: ollama (local, default) | openai_compat | anthropic_compat
LLM_PROVIDER=ollama
# Model name. Examples:
#   Ollama: phi3.5:3.8b, qwen2.5:7b, llama3.2:3b
#   OpenAI-compat: gpt-4o-mini, anthropic/claude-3.5-sonnet (via OpenRouter)
#   Anthropic-compat: claude-3-5-sonnet-20241022, claude-3-haiku-20240307
LLM_MODEL=phi3.5:3.8b
# Base URL:
#   Ollama default: http://localhost:11434
#   OpenAI: https://api.openai.com/v1  (or OpenRouter, Together, Groq, etc.)
#   Anthropic: https://api.anthropic.com  (or any Anthropic-format API)
LLM_BASE_URL=http://localhost:11434
# API key — required for openai_compat and anthropic_compat, ignored for ollama
LLM_API_KEY=

# === Telegram (required for notifications) ===
# Create a bot via @BotFather and paste the token here
TELEGRAM_BOT_TOKEN=
# Your personal chat id (get it from @userinfobot or similar)
TELEGRAM_CHAT_ID=
# Optional: forum topic ids for split channels
TELEGRAM_TOPIC_PICKS=
TELEGRAM_TOPIC_SUMMARY=

# === Schedule ===
# Daily pipeline run time (24h, local TZ)
CRON_DAILY_TIME=07:30
# AutoBuild poll cron expression (every N minutes)
CRON_AUTOBUILD_POLL=*/5

# === Features (toggled by install CLI, can also be edited here) ===
FEATURE_DAILY_SUMMARY_ENABLED=true
FEATURE_WEEKLY_DIGEST_ENABLED=false
FEATURE_AUTOBUILD_ENABLED=false
FEATURE_TELEGRAM_BOT_ENABLED=false
FEATURE_BACKFILL_ENABLED=false

# === ArXiv ===
ARXIV_CATEGORIES=q-fin.GN,q-fin.TR,q-fin.PR,q-fin.RM,q-fin.ST,q-fin.MF,cs.LG,stat.ML
ARXIV_LOOKBACK_HOURS=26
ARXIV_MAX_RESULTS=200
# Optional path to a JSON fixture (skips network fetch when set, used for testing)
ARXIV_FIXTURE_PATH=

# === Scoring ===
SCORE_STAGE_A_THRESHOLD=7.0
SCORE_STAGE_B_TOP_K=10
NOTIFY_TOP_K=3

# === Paths ===
DB_PATH=data/state.db
PDF_DIR=pdfs
LOG_DIR=logs
AUTOBUILD_DATA_DIR=data/autobuild
